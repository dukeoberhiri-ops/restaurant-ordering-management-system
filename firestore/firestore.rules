rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- Users ----
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // Customers can update their own profile and loyalty points (earned/redeemed via
      // checkout and the rewards page), but never their own role or account status.
      allow update: if isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Categories & Meals: public read, admin write ----
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /meals/{mealId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Tables (QR codes) ----
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Orders ----
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      // customers may only cancel their own pending orders; all other status changes are admin-only
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    // ---- Reservations ----
    match /reservations/{resId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---- Messages: public contact form, admin inbox ----
    match /messages/{messageId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Availability counters (per reservation slot) ----
    // Public read so the booking form's double-booking check works for
    // customers too, not just admins — deliberately not scoped to owner,
    // since it holds only an aggregate count, never personal data.
    match /availability/{slotId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ---- Reviews: public read, owner or admin write ----
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---- Promo codes: public read (to validate at checkout), admin write ----
    match /promoCodes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Notifications ----
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---- Restaurant settings (hours, info) ----
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
